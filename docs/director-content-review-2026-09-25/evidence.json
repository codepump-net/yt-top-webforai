  "sourceArticles": [
    {
      "number": 1,
      "title": "영통탑내과의원 소개｜정확한 진단과 환자 안전을 우선하는 수원 영통 내과",
      "line": 23,
      "characters": 1992
    },
    {
      "number": 2,
      "title": "박종설 원장 소개｜심장·초음파·내시경과 급성 내과질환을 함께 보는 내과 전문의",
      "line": 72,
      "characters": 1516
    },
    {
      "number": 3,
      "title": "영통탑내과 진료 분야 전체 안내｜심장·소화기·호흡기·암 지지진료부터 검진까지",
      "line": 119,
      "characters": 2608
    },
    {
      "number": 4,
      "title": "영통탑내과 검사와 장비 안내｜가능한 검사와 협력병원으로 의뢰하는 검사",
      "line": 168,
      "characters": 1683
    },
    {
      "number": 5,
      "title": "응급환자 평가와 상급병원 전원 원칙｜의원에서 기다리면 안 되는 상황",
      "line": 245,
      "characters": 1708
    },
    {
      "number": 6,
      "title": "영통탑내과 심장검사 순서｜심전도·Troponin I·심장초음파·72시간 홀터는 어떻게 선택하나요?",
      "line": 311,
      "characters": 2076
    },
    {
      "number": 7,
      "title": "심전도·72시간 홀터·심장초음파의 차이｜어떤 검사가 무엇을 보나요?",
      "line": 374,
      "characters": 1536
    },
    {
      "number": 8,
      "title": "국가건강검진은 어떤 순서로 진행되나요?｜영통탑내과 검진 과정과 준비사항",
      "line": 413,
      "characters": 2739
    },
    {
      "number": 9,
      "title": "영통탑내과 국가암검진 안내｜위암·대장암·간암·유방암·자궁경부암",
      "line": 497,
      "characters": 1362
    },
    {
      "number": 10,
      "title": "채용검진·공무원 채용신체검사·외국인 비자 검진 과정",
      "line": 541,
      "characters": 2692
    },
    {
      "number": 11,
      "title": "초음파검사 전 준비사항｜심장·복부·갑상선·경동맥초음파는 금식해야 하나요?",
      "line": 618,
      "characters": 1716
    },
    {
      "number": 12,
      "title": "위내시경 전 준비사항｜금식, 복용약, 수면내시경 보호자와 검사 후 주의점",
      "line": 668,
      "characters": 2412
    },
    {
      "number": 13,
      "title": "대장내시경 전 준비와 오라팡·플렌뷰 복용법, 용종절제 후 주의사항",
      "line": 756,
      "characters": 3620
    },
    {
      "number": 14,
      "title": "가슴통증이 있을 때 어떤 검사를 하나요?｜심전도와 Troponin I, 심장초음파의 역할",
      "line": 889,
      "characters": 1783
    },
    {
      "number": 15,
      "title": "심전도가 정상인데도 부정맥일 수 있나요?｜72시간 홀터가 필요한 경우",
      "line": 943,
      "characters": 1565
    },
    {
      "number": 16,
      "title": "심장판막 역류가 있으면 반드시 수술해야 하나요?",
      "line": 992,
      "characters": 1351
    },
    {
      "number": 17,
      "title": "협심증이면 모든 환자가 스텐트를 넣나요?",
      "line": 1038,
      "characters": 1262
    },
    {
      "number": 18,
      "title": "암 치료 중 가까운 내과에서 받을 수 있는 지지진료는 무엇인가요?",
      "line": 1073,
      "characters": 1579
    },
    {
      "number": 19,
      "title": "항암치료 중 38도 열이 나면 어떻게 해야 하나요?",
      "line": 1131,
      "characters": 1292
    },
    {
      "number": 20,
      "title": "갑자기 배가 아플 때 내과에서는 무엇을 확인하나요?｜급성 복통과 복부초음파",
      "line": 1179,
      "characters": 1380
    },
    {
      "number": 21,
      "title": "호흡기·감염·결핵·예방접종 진료 안내",
      "line": 1238,
      "characters": 1588
    },
    {
      "number": 22,
      "title": "고지혈증 약은 꼭 먹어야 하나요? 평생 먹어야 하나요?",
      "line": 1293,
      "characters": 1200
    },
    {
      "number": 23,
      "title": "운동과 식단으로 혈압·당뇨·고지혈증 약을 안 먹을 수 있나요?",
      "line": 1330,
      "characters": 1191
    },
    {
      "number": 24,
      "title": "담석이 있으면 꼭 담낭을 제거해야 하나요?",
      "line": 1372,
      "characters": 1171
    },
    {
      "number": 25,
      "title": "부모님이 심장병이면 저도 생기나요? 부정맥 약과 심장검사 추적간격 FAQ",
      "line": 1415,
      "characters": 1168
    },
    {
      "number": 26,
      "title": "폐렴구균·대상포진 예방접종은 언제 받나요?",
      "line": 1451,
      "characters": 1210
    },
    {
      "number": 27,
      "title": "부모님이 암이면 자녀는 어떤 검사를 받아야 하나요?",
      "line": 1486,
      "characters": 1152
    },
    {
      "number": 28,
      "title": "간수치가 계속 높은데 어떻게 해야 하나요?",
      "line": 1526,
      "characters": 1144
    },
    {
      "number": 29,
      "title": "대장용종이 자주 생기면 대장내시경을 얼마나 자주 해야 하나요?",
      "line": 1575,
      "characters": 1114
    },
    {
      "number": 30,
      "title": "갑상선암을 수술하지 않고 지켜봐도 괜찮나요?",
      "line": 1617,
      "characters": 1227
    },
    {
      "number": 31,
      "title": "살이 많이 찌지 않았는데 위고비나 마운자로를 미용 목적으로 써도 되나요?",
      "line": 1662,
      "characters": 1496
    },
    {
      "number": 32,
      "title": "오라팡 복용법｜28정 복용 순서와 물의 양, 대장내시경 준비에 실패하지 않는 법",
      "line": 1711,
      "characters": 1586
    },
    {
      "number": 33,
      "title": "플렌뷰 복용법｜1차·2차 복용과 추가 물, 맑은 유동식 안내",
      "line": 1770,
      "characters": 1559
    },
    {
      "number": 34,
      "title": "수면내시경은 보호자가 꼭 동행해야 하나요?｜검사 당일 운전과 귀가 안내",
      "line": 1837,
      "characters": 1083
    },
    {
      "number": 35,
      "title": "건강검진 전 약은 어떻게 먹나요?｜당뇨약·인슐린·혈압약과 피해야 할 음식",
      "line": 1886,
      "characters": 1993
    },
    {
      "number": 36,
      "title": "위·대장 조직검사와 용종절제 후 무엇을 먹고 언제 운동할 수 있나요?",
      "line": 1955,
      "characters": 1867
    },
